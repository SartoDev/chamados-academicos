// Single Prisma schema shared by every unit (DB-01).
// Conventions: models PascalCase singular, fields camelCase, tables snake_case plural via @@map,
// columns snake_case via @map, UUID identifiers, enum values in English SCREAMING_SNAKE.
// No row is ever deleted (deactivation only), so every foreign key is ON DELETE RESTRICT.
//
// Constraints that Prisma cannot express live in the migration SQL and must be kept. Every
// generated migration is reviewed before it is applied, so none of them is dropped.
//
// U1 (migration u1_foundation_initial):
// - CREATE EXTENSION citext (case-insensitive names and labels);
// - users.email stored in lowercase (CHECK);
// - users.sector_id present exactly for AGENT and MANAGER (CHECK, BR3.3);
// - non-empty names and labels with their maximum length (CHECK);
// - at most one default priority (partial unique index priorities_single_default_key).
//
// U2 (migration u2_tickets):
// - ticket title of 5 to 120 and description of 10 to 2000 characters (CHECK, BR1.2);
// - passage left_at, justification and transferred_by_id all present or all absent (CHECK, BR5.2);
// - exactly one open passage per ticket (partial unique index ticket_sector_passages_open_key);
// - history justification present exactly on SECTOR entries (CHECK, BR5.1);
// - history previous_value and new_value never both empty and never equal (CHECK);
// - notification read_at present exactly when read is true (CHECK, SM3).
//
// U3 (migration u3_conversation):
// - message body of 1 to 2000 characters once trimmed (CHECK, BR2.1).
//
// U5 (migration u5_rating):
// - rating score between 1 and 5 (CHECK, BR2.1);
// - rating comment of 1 to 500 characters once trimmed, when present (CHECK, BR2.2);
// - at most one rating per ticket (unique index ticket_ratings_ticket_id_key, BR2.3).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Exactly one of the five access profiles (BR3.2).
enum Role {
  STUDENT
  PROFESSOR
  AGENT
  MANAGER
  ADMIN

  @@map("role")
}

/// Stable status keys consumed by the ticket transition machine (BR4.6, ADR-006).
enum StatusKey {
  OPEN
  IN_ANALYSIS
  WAITING_REQUESTER
  CLOSED

  @@map("status_key")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  /// Stored normalized: trimmed and lowercase (BR1.1).
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  role         Role
  /// Required for AGENT and MANAGER, empty for every other role (BR3.3).
  sectorId     String?  @map("sector_id") @db.Uuid
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sector Sector? @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  requestedTickets     Ticket[]              @relation("TicketRequester")
  assignedTickets      Ticket[]              @relation("TicketAssignee")
  ticketHistoryEntries TicketHistoryEntry[]
  transferredPassages  TicketSectorPassage[]
  notifications        Notification[]
  messages             Message[]

  @@index([sectorId])
  @@index([role, active])
  @@map("users")
}

model Sector {
  id        String   @id @default(uuid()) @db.Uuid
  /// Unique ignoring letter case, counting inactive sectors (BR4.1).
  name      String   @unique @db.Citext
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users          User[]
  categories     Category[]
  tickets        Ticket[]
  ticketPassages TicketSectorPassage[]

  @@map("sectors")
}

model Category {
  id        String   @id @default(uuid()) @db.Uuid
  /// Unique within the sector, ignoring letter case (BR4.1).
  name      String   @db.Citext
  sectorId  String   @map("sector_id") @db.Uuid
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sector  Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  tickets Ticket[]

  @@unique([sectorId, name])
  @@map("categories")
}

model Status {
  id        String    @id @default(uuid()) @db.Uuid
  key       StatusKey @unique
  label     String    @unique @db.Citext
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@map("statuses")
}

model Priority {
  id        String   @id @default(uuid()) @db.Uuid
  label     String   @unique @db.Citext
  /// Exactly one active default priority (BR4.7).
  isDefault Boolean  @default(false) @map("is_default")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@map("priorities")
}

/// Attribute changed by a history entry (BR4.2, BR5.1).
enum TicketHistoryField {
  STATUS
  ASSIGNEE
  SECTOR
  PRIORITY

  @@map("ticket_history_field")
}

/// Event that produced an in-app notification (BR6.1). MESSAGE_RECEIVED is recorded by U3.
enum NotificationKind {
  MESSAGE_RECEIVED
  STATUS_CHANGED
  ASSIGNEE_CHANGED
  SECTOR_CHANGED
  TICKET_REOPENED

  @@map("notification_kind")
}

/// Academic request opened by a student or a professor and followed until it is closed.
model Ticket {
  id          String    @id @default(uuid()) @db.Uuid
  /// Visible identifier: a database sequence, never reused nor changed, shown as "#42" (BR1.6).
  number      Int       @unique @default(autoincrement())
  title       String    @db.VarChar(120)
  description String    @db.VarChar(2000)
  requesterId String    @map("requester_id") @db.Uuid
  assigneeId  String?   @map("assignee_id") @db.Uuid
  categoryId  String    @map("category_id") @db.Uuid
  /// Derived from the category when opened; changed only by a transfer (BR1.3, BR3.3).
  sectorId    String    @map("sector_id") @db.Uuid
  statusId    String    @map("status_id") @db.Uuid
  priorityId  String    @map("priority_id") @db.Uuid
  openedAt    DateTime  @default(now()) @map("opened_at") @db.Timestamptz(3)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(3)
  /// Set when the ticket is closed and cleared when it is reopened (BR4.3).
  closedAt    DateTime? @map("closed_at") @db.Timestamptz(3)

  requester User     @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  assignee  User?    @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sector    Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  status    Status   @relation(fields: [statusId], references: [id], onDelete: Restrict)
  priority  Priority @relation(fields: [priorityId], references: [id], onDelete: Restrict)

  historyEntries TicketHistoryEntry[]
  sectorPassages TicketSectorPassage[]
  notifications  Notification[]
  messages       Message[]
  /// At most one, written once by the requester after the closing (U5, BR2.3).
  rating         Rating?

  @@index([requesterId])
  @@index([sectorId, assigneeId])
  @@index([updatedAt])
  @@map("tickets")
}

/// Immutable record of one change of status, assignee, sector or priority (BR4.2, BR5.1).
model TicketHistoryEntry {
  id            String             @id @default(uuid()) @db.Uuid
  ticketId      String             @map("ticket_id") @db.Uuid
  field         TicketHistoryField
  /// Identifier of the previous status, user, sector or priority; empty when there was none.
  previousValue String?            @map("previous_value") @db.Uuid
  /// Identifier of the new value; empty when the value was removed.
  newValue      String?            @map("new_value") @db.Uuid
  /// Copy of the justification of the transfer, present exactly on SECTOR entries (AC2.4.4).
  justification String?            @db.VarChar(500)
  authorId      String             @map("author_id") @db.Uuid
  occurredAt    DateTime           @default(now()) @map("occurred_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([ticketId, occurredAt])
  @@map("ticket_history_entries")
}

/// Period the ticket spent in one sector, from arrival until it is transferred (M1, BR5.2).
model TicketSectorPassage {
  id              String    @id @default(uuid()) @db.Uuid
  ticketId        String    @map("ticket_id") @db.Uuid
  sectorId        String    @map("sector_id") @db.Uuid
  enteredAt       DateTime  @map("entered_at") @db.Timestamptz(3)
  /// Present once the ticket left the sector, together with justification and author.
  leftAt          DateTime? @map("left_at") @db.Timestamptz(3)
  justification   String?   @db.VarChar(500)
  transferredById String?   @map("transferred_by_id") @db.Uuid

  ticket        Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  sector        Sector @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  transferredBy User?  @relation(fields: [transferredById], references: [id], onDelete: Restrict)

  @@index([sectorId, ticketId])
  @@map("ticket_sector_passages")
}

/// In-app notice about something that happened in a ticket (BR6.1 to BR6.6).
model Notification {
  id          String           @id @default(uuid()) @db.Uuid
  recipientId String           @map("recipient_id") @db.Uuid
  ticketId    String           @map("ticket_id") @db.Uuid
  kind        NotificationKind
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  readAt      DateTime?        @map("read_at") @db.Timestamptz(3)

  recipient User   @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@index([recipientId, read, createdAt])
  @@map("notifications")
}

/// Message exchanged inside the ticket between the requester and the attendance (FR6, U3).
/// The foreign keys live only here: Ticket belongs to U2 and User to U1 (DB-01).
model Message {
  id       String   @id @default(uuid()) @db.Uuid
  ticketId String   @map("ticket_id") @db.Uuid
  /// The actor who sent the message; it never changes, not even when the user is deactivated.
  authorId String   @map("author_id") @db.Uuid
  /// Plain text of 1 to 2000 characters once trimmed; line breaks are kept (BR2.1).
  body     String   @db.VarChar(2000)
  sentAt   DateTime @default(now()) @map("sent_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  /// Serves both reading orders and the identifier tie-break of each one (BR3.1, BR3.2).
  @@index([ticketId, sentAt, id])
  @@map("messages")
}

/// Judgement the requester leaves on the service after the ticket is closed (FR12, U5).
/// The foreign key lives only here: Ticket belongs to U2 (DB-01). The author is not stored,
/// because it is always the requester of the ticket (entities.md).
model Rating {
  id       String   @id @default(uuid()) @db.Uuid
  /// One rating per ticket; the uniqueness is enforced by the database (BR2.3).
  ticketId String   @unique @map("ticket_id") @db.Uuid
  /// Integer from 1 to 5; each value has a fixed label shown by the web app (BR2.1).
  score    Int
  /// Optional plain text of 1 to 500 characters once trimmed; line breaks are kept (BR2.2).
  comment  String?  @db.VarChar(500)
  ratedAt  DateTime @default(now()) @map("rated_at") @db.Timestamptz(3)

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)

  @@map("ticket_ratings")
}
