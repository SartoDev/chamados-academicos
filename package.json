{
  "name": "academic-support-ticket",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de Chamados Acadêmicos",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces",
    "test:unit": "npm run test:unit --workspaces",
    "test:integration": "npm run test:integration -w apps/api",
    "test": "npm run test:unit && npm run test:integration",
    "test:coverage": "npm run test:coverage --workspaces",
    "openapi:generate": "npm run openapi:generate -w apps/api",
    "prepare": "node scripts/install-git-hooks.mjs"
  },
  "overrides": {
    "multer": "2.3.0",
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.4",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
