# Copie este arquivo para .env e preencha os valores antes de subir o sistema.
# O .env nunca é versionado. Nenhum valor abaixo é real.

# --- Banco de dados principal (serviço "postgres" do Docker Compose) ---
POSTGRES_USER=app
POSTGRES_DB=chamados
# Use só letras e algarismos: a senha entra na URL de conexão.
POSTGRES_PASSWORD=

# Conexão usada pela API quando ela roda fora do Docker (desenvolvimento local).
# Dentro do Docker Compose a URL é montada a partir das variáveis POSTGRES_*.
DATABASE_URL=postgresql://USUARIO:SENHA@127.0.0.1:55432/BANCO

# --- Banco de teste (serviço "postgres-test", perfil "test") ---
# A porta é publicada somente em 127.0.0.1.
POSTGRES_TEST_USER=app_test
POSTGRES_TEST_DB=chamados_test
POSTGRES_TEST_PASSWORD=
POSTGRES_TEST_PORT=55432
DATABASE_URL_TEST=postgresql://USUARIO:SENHA@127.0.0.1:55432/BANCO

# --- Sessão ---
# Segredo de assinatura do token, com no mínimo 32 caracteres. Para gerar:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Origem em que o navegador abre o sistema. Requisições que alteram dados vindas de outra origem são recusadas.
APP_ORIGIN=http://localhost:8080
# Use true somente quando o sistema for servido por HTTPS.
COOKIE_SECURE=false

# --- Administrador inicial ---
# Criado na subida apenas se não existir nenhum administrador ativo.
INITIAL_ADMIN_EMAIL=
# De 8 a 128 caracteres, com ao menos uma letra e um algarismo.
INITIAL_ADMIN_PASSWORD=
